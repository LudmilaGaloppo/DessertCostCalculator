{
  "name": "desserts-cost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "start:api": "node --env-file-if-exists=.env .node-build/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json",
    "build": "npm run typecheck && vite build",
    "build:node": "tsc",
    "preview": "vite preview --host 127.0.0.1",
    "example": "npm run build:node && node .node-build/examples/recipe-cost.js",
    "test": "npm run build:node && node --test .node-build/tests/*.test.js",
    "test:integration": "npm run build:node && node --env-file-if-exists=.env --test .node-build/tests/integration/*.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "5.3.0",
    "mongoose": "9.12.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.92.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vite": "6.4.6"
  }
}
