{
  "name": "@dessert-cost/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "build": "npm run typecheck && vite build",
    "build:node": "tsc -p tsconfig.tests.json",
    "preview": "vite preview --host 127.0.0.1",
    "example": "npm run build:node && node .node-build/examples/recipe-cost.js",
    "test": "npm run build:node && node --test .node-build/tests/*.test.js"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.92.0"
  },
  "devDependencies": {
    "@dessert-cost/shared": "0.1.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
