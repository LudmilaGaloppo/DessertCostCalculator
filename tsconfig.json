{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": ".node-build",
    "strict": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/domain/**/*.ts", "src/types/**/*.ts", "src/utils/**/*.ts", "examples/**/*.ts", "tests/**/*.ts"],
  "exclude": ["dist", ".node-build", "node_modules"]
}
